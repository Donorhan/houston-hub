{
  "schema_version": 2,
  "name": "Postgres",
  "description": "Query a Postgres database and optionally execute writes.",
  "setup": "Use a database role with the privileges you want this connection to have.",
  "files": [
    "query.luau",
    "execute.luau"
  ],
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Read and write"
        }
      ],
      "default": "read"
    }
  ],
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "placeholder": "database.example.com",
      "required": true,
      "order": 1
    },
    "port": {
      "type": "integer",
      "label": "Port",
      "default": 5432,
      "minimum": 1,
      "maximum": 65535,
      "order": 2
    },
    "database": {
      "type": "string",
      "label": "Database",
      "required": true,
      "order": 3
    },
    "username": {
      "type": "string",
      "label": "Username",
      "required": true,
      "order": 4
    },
    "password": {
      "type": "secret",
      "label": "Password",
      "required": true,
      "order": 6
    }
  },
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "port": "{{config.port}}",
          "tls": {
            "mode": "verify-full"
          },
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "postgres"
      }
    }
  ]
}
